[Unit]
Description=HappyRO Go API
After=network.target

[Service]
Type=simple
User=happyro-admin
Group=happyro-admin
SupplementaryGroups=happyro
WorkingDirectory=/vol2/1000/kugarocks/happyro/repos/happyro-api
EnvironmentFile=/vol2/1000/kugarocks/happyro/repos/happyro-api/.env
Environment=HTTP_LISTEN=0.0.0.0:18081
ExecStart=/usr/local/bin/happyro-api serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
