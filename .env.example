# Export these variables before running the CLI, or use systemd EnvironmentFile.
# Go does not automatically load a .env file.
HAPPYRO_API_LISTEN_ADDRESS=0.0.0.0:18081
# IANA display time zone; timestamps remain UTC.
HAPPYRO_TIMEZONE=Asia/Shanghai
HAPPYRO_ADMIN_PUBLIC_URL=http://localhost:18081
HAPPYRO_ADMIN_CSRF_ORIGIN_CHECK_ENABLED=false
HAPPYRO_ADMIN_PASSWORD_CHANGE_ENABLED=true
# Allow editing the default player registration group in the administration UI.
# 可选：0=普通玩家，99=GM；留空保留数据库设置，每次 API 启动重新应用非空值。
HAPPYRO_REGISTRATION_DEFAULT_GROUP_ID=
HAPPYRO_REGISTRATION_DEFAULT_GROUP_EDITABLE=true
HAPPYRO_API_LOG_LEVEL=info
GIN_MODE=release
HAPPYRO_API_TRUSTED_PROXIES=

HAPPYRO_ADMIN_INITIAL_USERNAME=admin
HAPPYRO_ADMIN_INITIAL_PASSWORD=admin
HAPPYRO_ADMIN_DEFAULT_CREDENTIALS_HINT_ENABLED=false

# Use a new empty management database; the Laravel schema is not compatible.
HAPPYRO_API_ADMIN_DB_HOST=127.0.0.1
HAPPYRO_API_ADMIN_DB_PORT=33062
HAPPYRO_API_ADMIN_DB_NAME=happyro_admin_go
HAPPYRO_API_ADMIN_DB_USERNAME=happyro_admin
HAPPYRO_API_ADMIN_DB_PASSWORD=

HAPPYRO_API_GAME_DB_HOST=127.0.0.1
HAPPYRO_API_GAME_DB_PORT=3306
HAPPYRO_API_GAME_DB_NAME=happyro
HAPPYRO_API_GAME_LOG_DB_NAME=happyro_log
HAPPYRO_API_GAME_DB_USERNAME=happyro_admin
HAPPYRO_API_GAME_DB_PASSWORD=
HAPPYRO_GAME_ADMIN_GROUP_IDS=2,3,4,10,99
HAPPYRO_API_GAME_CONTROL_UPSTREAM_URL=http://127.0.0.1:8889
HAPPYRO_GAME_CONTROL_TOKEN=
HAPPYRO_API_GAME_CONTROL_TIMEOUT=3s

HAPPYRO_API_ITEM_IMAGE_DIR=/opt/happyro/resources/catalog/items
HAPPYRO_API_MONSTER_IMAGE_DIR=/opt/happyro/resources/catalog/monsters
HAPPYRO_API_MAP_INDEX_PATH=../happyro-server/db/map_index.txt
HAPPYRO_API_WORLD_ASSET_DIR=resources/game-data/world
# Mount/share the containing directory with the game server; writes use rename.
HAPPYRO_API_BATTLE_CONFIG_PATH=/run/happyro-settings/battle_conf.txt

HAPPYRO_ADMIN_SESSION_LIFETIME=2h
HAPPYRO_ADMIN_SESSION_REMEMBER_LIFETIME=720h
HAPPYRO_ADMIN_SESSION_SECURE_COOKIE_ENABLED=false
