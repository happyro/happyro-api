# Export these variables before running the CLI, or use systemd EnvironmentFile.
# Go does not automatically load a .env file.
HTTP_LISTEN=0.0.0.0:18081
# IANA display time zone; timestamps remain UTC.
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:18081
ADMIN_CSRF_ORIGIN_CHECK_ENABLED=false
FRONTEND_DIR=../happyro-admin/dist
LOG_LEVEL=info
GIN_MODE=release
HTTP_TRUSTED_PROXIES=

ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin
SHOW_DEFAULT_CREDENTIALS=false

# Use a new empty management database; the Laravel schema is not compatible.
DB_HOST=127.0.0.1
DB_PORT=33062
DB_DATABASE=happyro_admin_go
DB_USERNAME=happyro_admin
DB_PASSWORD=

GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_DATABASE=happyro
GAME_LOG_DB_DATABASE=happyro_log
GAME_DB_USERNAME=happyro_admin
GAME_DB_PASSWORD=
GAME_ADMIN_GROUP_IDS=2,3,4,10,99
GAME_CONTROL_BASE_URL=http://127.0.0.1:8889
GAME_CONTROL_TOKEN=
GAME_CONTROL_TIMEOUT=3s

GAME_ITEM_IMAGE_ROOT=/opt/happyro/resources/catalog/items
GAME_MONSTER_IMAGE_ROOT=/opt/happyro/resources/catalog/monsters
GAME_MAP_INDEX_PATH=../happyro-server/db/map_index.txt
GAME_WORLD_ASSET_ROOT=resources/game-data/world
# Mount/share the containing directory with the game server; writes use rename.
GAME_SERVER_BATTLE_CONFIG_PATH=/run/happyro-settings/battle_conf.txt

SESSION_LIFETIME=2h
SESSION_REMEMBER_LIFETIME=720h
SESSION_SECURE_COOKIE=false
